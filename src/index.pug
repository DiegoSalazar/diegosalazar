doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    meta(name="theme-color", content="#f5f3ed")
    title= `${cv.basics.name} — Senior/Staff Software Engineer`
    meta(name="description", content=cv.meta.description)
    meta(property="og:title", content=`${cv.basics.name} — Software Engineer`)
    meta(property="og:description", content=cv.meta.description)
    meta(property="og:type", content="website")
    meta(property="og:url", content=cv.basics.url)
    meta(name="twitter:card", content="summary")
    link(rel="canonical", href=cv.basics.url)
    link(rel="stylesheet", href="styles.css")
    link(rel="stylesheet", href="custom.css")
    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap", rel="stylesheet")

  body
    a.skip-link(href="#main-content") Skip to content
    include sections/hero.pug
    main#main-content.site-main
      section#about.page-section.about-section
        div.section-heading
          p.eyebrow 01 / A little about me
          h2 The short version
        div.about-copy
          each para in cv.basics.summary
            p= para
        div.about-footnote
          span= cv.basics.location.city + ", " + cv.basics.location.region
          span.about-divider
          span 20 years building software
          span.about-divider
          span Former VP of Engineering

      section#experience.page-section
        div.section-heading.section-heading-row
          div
            p.eyebrow 02 / The work
            h2 Experience
          p.section-note From hands-on product engineering to growing teams and setting technical direction.
        div.experience-list
          each job, index in cv.work
            article.experience-item
              div.experience-index= String(index + 1).padStart(2, '0')
              div.experience-body
                div.experience-title-row
                  div
                    if job.url
                      h3
                        a.company-link(href=job.url, target="_blank", rel="noopener noreferrer")= job.name
                    else
                      h3= job.name
                    p.job-title= job.position
                  div.experience-meta
                    p.job-dates= job.dateRange || `${job.startDate} – ${job.endDate}`
                    if job.location
                      p.job-location= job.location
                if job.summary
                  p.job-summary= job.summary
                if job.highlights && job.highlights.length
                  ul.achievement-list
                    each highlight in job.highlights
                      li= highlight
                if job.stack
                  p.job-stack
                    span.stack-label Stack
                    |  #{job.stack}

      section#projects.page-section
        div.section-heading.section-heading-row
          div
            p.eyebrow 03 / Outside the day job
            h2 Selected projects
          p.section-note Small experiments and open-source work, kept for the curious.
        div.project-grid
          each project in cv.projects
            article.project-card
              if project.images && project.images.length
                a.project-image(href=project.url || project.githubUrl, target="_blank", rel="noopener noreferrer", tabindex="-1", aria-hidden="true")
                  img(src=project.images[0], alt="")
              div.project-content
                h3= project.name
                p= project.summary
                div.project-links
                  if project.url
                    a(href=project.url, target="_blank", rel="noopener noreferrer") View project ↗
                  if project.githubUrl
                    a(href=project.githubUrl, target="_blank", rel="noopener noreferrer") Source ↗

      if cv.volunteer && cv.volunteer.length
        section#volunteer.page-section
          div.section-heading
            p.eyebrow 04 / Sharing what I know
            h2 Teaching & mentoring
          div.community-list
            each vol in cv.volunteer
              article.community-item
                div
                  if vol.url
                    h3
                      a.company-link(href=vol.url, target="_blank", rel="noopener noreferrer")= vol.organization
                  else
                    h3= vol.organization
                  p.job-title= vol.position
                p= vol.summary

      section#testimonials.page-section
        div.section-heading.section-heading-row
          div
            p.eyebrow 05 / Kind words
            h2 From people I've worked with
          p.section-note A few notes from teammates and collaborators.
        div.testimonial-grid
          each ref in cv.references
            figure.testimonial-card
              blockquote= ref.reference
              figcaption
                strong= ref.name
                if ref.title
                  span= ref.title

      section#details.page-section.details-section
        div.section-heading
          p.eyebrow 06 / The toolkit
          h2 Skills & languages
        div.details-grid
          div.detail-block
            h3 Top skills
            div.skill-list
              each skill in cv.skills.topSkills
                span.skill-chip= skill
            h3.technology-heading Across the stack
            p.detail-copy= cv.meta.technologySummary
          div.detail-block
            h3 Languages
            each lang in cv.languages
              div.language-row
                span= lang.language
                span.language-fluency= lang.fluency
            h3.certification-heading Certification
            each certification in cv.certifications
              p.detail-copy= certification.name
          div.detail-block.education-block
            h3 Education
            each course in cv.education
              div.education-row
                strong= course.institution
                span= course.dateRange

    include sections/contact.pug
    include sections/jump-to-top-btn.pug
    script(src="main.js")
