footer#contact.site-footer
  div.footer-inner
    div.footer-topline
      p.eyebrow 07 / Start a conversation
      p.footer-location= `${cv.basics.location.city}, ${cv.basics.location.region}`
    h2
      | Good work starts
      br
      | with a good conversation.
    div.footer-actions
      a.button.button-light(href=`mailto:${cv.basics.email}`)= cv.basics.email
      if cv.meta.resumeUrl
        a.button.button-outline(href=cv.meta.resumeUrl, target="_blank", rel="noopener noreferrer")
          | Download résumé
          span(aria-hidden="true") ↗
    div.footer-bottom
      p © #{new Date().getFullYear()} #{cv.basics.name}
      nav.footer-socials(aria-label="Social profiles")
        each profile in cv.basics.profiles
          a(href=profile.url, target="_blank", rel="noopener noreferrer")= profile.network + " ↗"
