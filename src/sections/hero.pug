header#home.site-header
  nav.site-nav(aria-label="Main navigation")
    a.site-wordmark(href="#home" aria-label="Diego Salazar, home")
      | DS
      span.site-wordmark-dot .
    div.nav-links
      a(href="#about") About
      a(href="#experience") Experience
      a(href="#projects") Projects
      a(href="#volunteer") Teaching
      a(href="#details") Skills
    a.nav-contact(href="#contact")
      | Get in touch
      span(aria-hidden="true") ↗

  div.hero-wrap
    div.hero-copy
      p.eyebrow.hero-eyebrow= `Software engineer · ${cv.basics.location.city}, ${cv.basics.location.country}`
      h1= cv.basics.name
      p.hero-role= cv.basics.label
      p.hero-intro= cv.basics.tagline
      div.hero-actions
        a.button.button-primary(href=cv.meta.resumeUrl, target="_blank", rel="noopener noreferrer")
          | Download résumé
          span(aria-hidden="true") ↗
        a.button.button-quiet(href=`mailto:${cv.basics.email}`) Let's talk
      div.hero-contact-line
        a(href=`mailto:${cv.basics.email}`)= cv.basics.email
        span.hero-contact-dot
        a(href=`tel:${cv.basics.phone}`)= cv.basics.phone
    div.hero-photo-wrap
      img.hero-photo(src=cv.basics.image, alt=`Portrait of ${cv.basics.name}`)
      div.hero-photo-caption
        span.hero-status-dot
        span Building AI-powered products & the platforms beneath them
  div.hero-bottom
    span 20 years of building for the web and beyond
    a(href="#experience")
      | Scroll to explore
      span(aria-hidden="true") ↓
